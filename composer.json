{
    "name": "iutrace/laravel-fixerio",
    "description": "Laravel package/client for fixer.io api, a foreign exchange rates and currency conversion API.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Abbas Ali",
            "email": "abbas@ranium.in",
            "homepage": "https://ranium.in",
            "role": "Developer"
        }
        , {
            "name": "Utrace",
            "email": "sdiaz@utrace.tech",
            "homepage": "https://utrace.tech",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1|^8.2|^8.3",
        "ranium/fixerio-php-client": "1.*",
        "laravel/framework": "^9.0|^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^7.0|^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^9.0|^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Ranium\\LaravelFixerio\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ranium\\LaravelFixerio\\Test\\": "tests"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ranium\\LaravelFixerio\\ServiceProvider"
            ],
            "aliases": {
                "Fixerio": "Ranium\\LaravelFixerio\\Facade"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
